rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reusable helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Health check test connection endpoint
    match /test/{docId} {
      allow read: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isValidId(userId);
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow read: if true;
      allow create, update: if isValidId(transactionId);
      allow delete: if isValidId(transactionId);
    }

    // Goals Collection
    match /goals/{goalId} {
      allow read: if true;
      allow create, update, delete: if isValidId(goalId);
    }

    // Recurring Transactions Collection
    match /recurring/{recurringId} {
      allow read: if true;
      allow create, update, delete: if isValidId(recurringId);
    }

    // Couple Invites Collection
    match /invites/{inviteId} {
      allow read: if true;
      allow create, update, delete: if isValidId(inviteId);
    }
  }
}
