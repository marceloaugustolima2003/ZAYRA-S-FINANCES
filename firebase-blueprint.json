{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "User profile data for registered users",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "User's full name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "User's email address",
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "description": "User profile photo URL",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["displayName", "email"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "Financial income or expense transaction",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Transaction title or establishment",
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Expense or income category",
          "maxLength": 50
        },
        "institution": {
          "type": "string",
          "description": "Bank or payment origin",
          "maxLength": 80
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment instrument used",
          "maxLength": 60
        },
        "amount": {
          "type": "number",
          "description": "Monetary value in BRL"
        },
        "type": {
          "type": "string",
          "description": "Transaction direction",
          "enum": ["income", "expense"]
        },
        "date": {
          "type": "string",
          "description": "YYYY-MM-DD date string",
          "maxLength": 20
        },
        "time": {
          "type": "string",
          "description": "HH:mm time string",
          "maxLength": 10
        },
        "notes": {
          "type": "string",
          "description": "Optional user notes",
          "maxLength": 500
        },
        "iconName": {
          "type": "string",
          "description": "Icon identifier",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        }
      },
      "required": ["userId", "title", "category", "amount", "type", "date"]
    },
    "financialGoal": {
      "title": "FinancialGoal",
      "description": "Financial savings goal and milestone",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Goal title",
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "description": "Goal category",
          "maxLength": 50
        },
        "targetAmount": {
          "type": "number",
          "description": "Target amount to reach"
        },
        "currentAmount": {
          "type": "number",
          "description": "Currently accumulated amount"
        },
        "deadline": {
          "type": "string",
          "description": "Estimated deadline date or label",
          "maxLength": 30
        },
        "icon": {
          "type": "string",
          "description": "Icon identifier",
          "maxLength": 30
        },
        "color": {
          "type": "string",
          "description": "Hex color code",
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        }
      },
      "required": ["userId", "title", "targetAmount", "currentAmount"]
    },
    "categoryBudget": {
      "title": "CategoryBudget",
      "description": "Monthly spending cap limit for a category",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "category": {
          "type": "string",
          "description": "Category name",
          "maxLength": 50
        },
        "limit": {
          "type": "number",
          "description": "Monthly spending ceiling in BRL"
        },
        "color": {
          "type": "string",
          "description": "Hex color code",
          "maxLength": 30
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of update"
        }
      },
      "required": ["userId", "category", "limit"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/userProfile"
      },
      "description": "Stores user profile data accessible strictly by the user"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/transaction"
      },
      "description": "Financial income and expense transactions for each user"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": {
        "$ref": "#/entities/financialGoal"
      },
      "description": "Financial goals and milestones for each user"
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": {
        "$ref": "#/entities/categoryBudget"
      },
      "description": "Category monthly budget limits for each user"
    }
  }
}
